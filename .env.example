# Required. Signs and verifies the session cookie.
#
# There is no fallback. The application fails closed without it: API requests
# are refused rather than verified against a default, because a default secret
# is a published secret. Set it here for local development; Vercel supplies it
# in Preview and Production.
#
# Generate one with:  openssl rand -base64 48
JWT_SECRET=

# Required. The CRM database.
MONGODB_URI=
MONGODB_DB=ag

# Warehouse token issuance (Auth Integration Gate step 6-7).
# RS256. The CRM holds the PRIVATE half and is the only thing that can mint a
# Warehouse token; Warehouse holds the public half and can only verify. Never
# reuse JWT_SECRET here — a shared secret would let Warehouse forge CRM
# sessions. Absent means /api/auth/warehouse-token returns 503; it never falls
# back to anything.
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out wh.key
#   openssl pkey -in wh.key -pubout -out wh.pub      # this half goes to Warehouse
# WAREHOUSE_JWT_PRIVATE_KEY=
# WAREHOUSE_JWT_ISSUER=https://<this-app-origin>

# Optional — features degrade cleanly when absent.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_ADMIN_EMAIL=
# SUPABASE_ADMIN_PASSWORD=
# ANTHROPIC_API_KEY=
# AI_INGEST_TOKEN=
